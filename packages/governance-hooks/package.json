{
  "name": "@luxfi/governance-hooks",
  "version": "0.1.0",
  "description": "Shared governance hooks for Lux DAO ecosystem",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=19.2.8",
    "wagmi": ">=3",
    "viem": ">=2"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "wagmi": "^3.7.7",
    "viem": "^2.56.0"
  },
  "keywords": [
    "lux",
    "dao",
    "governance",
    "wagmi",
    "hooks"
  ],
  "author": "Lux Industries Inc",
  "license": "MIT"
}
