{
  "name": "@luxdao/ui",
  "version": "0.1.0",
  "description": "Lux DAO UI Component Library",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs:api": "typedoc --out docs/api src/index.ts",
    "docs:serve": "pnpm build-storybook && serve storybook-static"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "react": ">=19.2.8",
    "react-dom": ">=19.2.8"
  },
  "dependencies": {
    "@chakra-ui/anatomy": "^2.3.4",
    "@phosphor-icons/react": "^2.1.10",
    "framer-motion": "^13.1.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/addon-themes": "^10.5.10",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "storybook": "^10.5.10",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "format": [
      "cjs",
      "esm"
    ],
    "dts": true,
    "sourcemap": true,
    "clean": true,
    "external": [
      "react",
      "react-dom",
      "@chakra-ui/react",
      "@emotion/react",
      "@emotion/styled"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxdao/dao.git"
  },
  "keywords": [
    "lux",
    "dao",
    "ui",
    "components",
    "react",
    "chakra-ui"
  ],
  "author": "Lux DAO Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/luxdao/dao/issues"
  },
  "homepage": "https://github.com/luxdao/dao/tree/main/packages/ui#readme"
}
